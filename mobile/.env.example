# Alamat backend REST API. Hanya variabel ini yang dipakai aplikasi.
# Android emulator: http://10.0.2.2:3000
# Web / iOS simulator: http://localhost:3000
# Perangkat fisik: http://<IP-LAN-komputer>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Registrasi teknisi mandiri. Default true agar build demo tetap bisa mendaftar.
# Set false untuk build yang terbuka ke publik: tautan "Daftar" hilang dan
# /(auth)/register dialihkan ke login. Ini hanya kebijakan UI, bukan pengamanan:
# server atau WAF juga harus memblokir POST /api/auth/register.
EXPO_PUBLIC_ALLOW_REGISTRATION=true
