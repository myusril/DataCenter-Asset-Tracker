# Database
# Local PostgreSQL 16 development instance. Fill in your own credentials;
# never commit the real values.
DATABASE_URL=""

# Auth
# At least 32 characters. Generate one with: openssl rand -hex 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# CORS: comma-separated allowlist. Empty reflects any origin (local dev only).
CORS_ORIGIN=""

# Server
PORT=3000
NODE_ENV=development

# Seed accounts (used only by `npm run prisma:seed`)
SEED_ADMIN_PASSWORD=""
SEED_TECH_PASSWORD=""
